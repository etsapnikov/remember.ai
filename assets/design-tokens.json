      "dur": 900,
      "ease": "cubic-bezier(.3,0,.6,1)"
    },
    "followSettle": {
      "dur": 320,
      "ease": "cubic-bezier(.2,.8,.2,1)",
      "minDur": 180
    },
    "followCancel": {
      "dur": 200,
      "ease": "cubic-bezier(.4,0,.6,1)"
    },
    "keyPress": {
      "dur": 90,
      "ease": "cubic-bezier(.4,0,1,1)"
    },
    "keyRelease": {
      "dur": 160,
      "ease": "cubic-bezier(.2,.8,.2,1)"
    },
    "stateShift": {
      "dur": 220,
      "ease": "cubic-bezier(.4,0,.2,1)",
      "ringDelay": 60
    },
    "ampAttack": {
      "dur": 100,
      "ease": "linear"
    },
    "ampRelease": {
      "tau": 220,
      "ease": "ease-out"
    }
  },
  "haptics": {
    "receipt": "двойной короткий: 18ms — пауза 70ms — 34ms",
