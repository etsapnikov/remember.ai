# Токен приложения. Сгенерировать: openssl rand -hex 32
# В приложении живёт в EncryptedSharedPreferences (PRD §7).
PRINYAL_API_TOKEN=

# Ключ DeepSeek — только здесь, в APK его нет.
DEEPSEEK_API_KEY=
LLM_MODEL=deepseek-v4-flash
# Опция «качество»: deepseek-v4-pro. В R1 не дефолт (PRD §2.2).
LLM_ENABLED=1
LLM_TIMEOUT_S=15
LLM_RETRIES=2

# stub | gigaam
ASR_BACKEND=stub
ASR_TIMEOUT_S=20
ASR_MODEL_PATH=/models/gigaam
# energy | silero
VAD_BACKEND=energy

# Домен для caddy (профиль tls). Без него — только tailscale.
PRINYAL_DOMAIN=api.prinim.ai

# Логи запросов выключены: бэкенд stateless (PRD §2).
LOG_PAYLOADS=0
